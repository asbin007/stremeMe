# Copy to .env.local, fill in real values. Never commit the filled copy.
# Vite exposes every VITE_* var to the browser bundle, so use only
# publishable / read-only tokens here.

# Clerk (auth) — dashboard.clerk.com -> API Keys -> Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# TMDB (metadata) — themoviedb.org/settings/api -> API Read Access Token (v4)
VITE_TMDB_ACCESS_TOKEN=your_tmdb_v4_token_here

# Backend base URL. Omit for localhost; override for production builds.
VITE_API_BASE_URL=https://backend-streame.onrender.com/api

# Optional — region/language defaults for TMDB discover + watch providers
VITE_WATCH_REGION=US
VITE_TMDB_LANGUAGE=en-US

# Optional — Firebase push notifications. Leave unset to disable push entirely.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
